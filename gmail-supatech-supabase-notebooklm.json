      "position": [680, 320],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_YOUR_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentURL": "1ePFvCIAK4GqagEZpgolVGduIrWI0eTwzu0P5qZkM2jM",
        "actionsUi": {
